# Recorded-session database. Lives at ~/.claude/layman.db, but a stray copy or a
# backup pulled into the repo must never be committed — it contains full session
# transcripts, and the -wal/-shm siblings are meaningless without it.
*.db
*.db-wal
*.db-shm
layman-backup-*/
