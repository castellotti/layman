  "lines": [
    { "line": "grep -E \"a|curl|b\" src/x.ts", "station": "files", "why": "a | inside quotes is not a pipe" },
    { "line": "echo $(curl -s https://x)", "station": "network", "why": "inside $(…)" },
    { "line": "echo `wget -q https://x`", "station": "network", "why": "inside backticks" },
    { "line": "x=\"$(curl -s https://x)\"", "station": "network", "why": "inside $(…) inside double quotes" },
    { "line": "diff <(curl -s https://a) b.txt", "station": "network", "why": "process substitution" },
    { "line": "cd /repo && git -C sub push origin main", "station": "network", "why": "git subcommand after -C <dir>" },
    { "line": "git -C /repo diff --stat", "station": "shell", "why": "a local git subcommand" },
    { "line": "pnpm --filter web add zod", "station": "network", "why": "pnpm subcommand after --filter <pkg>" },
    { "line": "uv pip install requests", "station": "network", "why": "a two-word subcommand" },
