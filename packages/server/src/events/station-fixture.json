    { "line": "rsync -avz -e ssh dist/ me@box.local:/srv/app/", "station": "network", "why": "a host:path argument" },
    { "line": "scp a.txt box:/tmp/", "station": "network" },
    { "line": "cp C:/x.txt D:/y.txt", "station": "files", "why": "a Windows drive is not a host" },
    { "line": "LANG=C sort -u a.txt > b.txt", "station": "files", "why": "a leading assignment and a redirection target" },
    { "line": "sudo -u web cat /etc/hosts", "station": "files", "why": "a wrapper with a value flag" },
    { "line": "timeout 30 curl -s https://x", "station": "network", "why": "timeout's duration" },
    { "line": "find . -name '*.ts' | xargs -I {} grep -l foo {}", "station": "files", "why": "xargs runs grep" },
    { "line": "bash -c 'curl -s https://x | jq .'", "station": "network", "why": "bash -c is the line inside it" },
    { "line": "sh -c \"ls -la && wc -l a\"", "station": "files" },
    { "line": "python3 - <<'EOF'\nimport json\nprint(json.dumps({'a': \"don't curl\"}))\nEOF", "station": "shell", "why": "a heredoc body is data" },
    { "line": "git commit -m \"$(cat <<'EOF'\nFix it: don't (ever) break\nEOF\n)\"", "station": "shell", "why": "a heredoc inside $(…) with apostrophes and parentheses" },
    { "line": "cat <<EOF > out.txt\ncurl https://x\nEOF\nwc -l out.txt", "station": "files", "why": "the heredoc is data, the commands after it still count" },
    { "line": "for f in *.ts; do wc -l \"$f\"; done", "station": "files", "why": "for/do/done are not commands" },
    { "line": "for rt in docker podman; do RT=$rt bash t.sh; done", "station": "shell", "why": "keyword then assignment" },
    { "line": "if [[ -n \"$x\" && -f a ]]; then cat a; fi", "station": "files", "why": "&& inside [[ ]] is the test's" },
    { "line": "H=(--rm --cap-drop ALL); docker run \"${H[@]}\" img", "station": "shell", "why": "an array assignment is one word" },
    { "line": "echo hi && cd /tmp && pwd", "station": "shell", "why": "only neutral commands" },
    { "line": "cat a.txt 2>&1 | head -5 # curl is only a comment", "station": "files", "why": "a comment" },
    { "line": "ls \\\n  -la /tmp", "station": "files", "why": "a line continuation" },
    { "line": "/usr/bin/curl -s https://x", "station": "network", "why": "a command named by its path" },
    { "line": "\"C:\\Program Files\\Git\\cmd\\git.EXE\" push", "station": "network", "why": "a quoted Windows program path" },
